# Model : ChromoSSE
# Clade : Dryopteridaceae
# TensorPhylo = TRUE

#####################################################################
## This is a control script for the ChromoHiSSE model script.      ##
## If you are having trouble using it or have questions, please    ##
## reach out to Thomas Buchloh (thomas.d.buchloh@gmail.com or      ##
## thomas.buchloh@univie.ac.at) for assistance.                    ##
##                                                                 ##
## These scripts (model script and control script) were built      ##
## to be used with the mrm_dev branch of RevBayes (GitHub commit   ##
## 9919664). The functions in these scripts may not work properly  ##
## on other branches.                                              ##
#####################################################################

#### TENSORPHYLO
loadPlugin("TensorPhylo", "/home/tbuchlo/software")
# number of processes for TensorPhylo
nProc = 4

#### LOAD THE PHYLOGENETIC TREE
tree = readTrees("data/dryopteridaceae_csomepruned.tree")[1]
# tree = tree.jitter(1e-5) # turn on if any nodes in tree have equal height.

#### MAXIMUM CHROMOSOME COUNT ALLOWED (k = max+10)
k    = 174
#### LOAD THE CHROMOSOME COUNT DATA
data = readCharacterDataDelimited("data/dryopteridaceae_counts.tsv", 
                                  stateLabels= (k + 1), 
                                  type="NaturalNumbers", 
                                  delimiter="\t", 
                                  header=FALSE)

#### SET FILE PATHS FOR LOG AND CHECKPOINT FILES
log_file = "output/chromosse_dryopt_par1.log"
checkpt = "output/checkpts/chromosse_dryopt_checkpt_par1.state"
SCMlog_file = "output/chromosse_dryopt_SCM_par1.log"

#### RUN CONDITIONS
# initialize from a checkpoint? (0 = No , 1 = Y)
reinitiate = 0

# perform stochastic character mapping? (0 = No , 1 = Y)
SCMing = 0
SCM_sample_freq = 10

# Set the number of iterations for burnin/tuning/tuningInterval/post-tuning:
burnin = 0
tuneBurn = 2000
tuningInt = 500
postBurn = 100000

# Set the number of iterations to sample from MCMC
model_sample_freq = 1  # model monitor
checkpt_interval = 10  # checkpoint saves

#### SET PRIORS
# Anagenic rates
gamma ~ dnExponential(0.1) # ascending dysploidy
delta ~ dnExponential(0.1) # descending dysploidy
rho ~ dnExponential(0.1)   # polyploidy
eta ~ dnExponential(0.1)   # demipolyploidy

# Cladogenic rates
taxa <- tree.taxa()
speciation_mean <- ln( taxa.size() ) / tree.rootAge()
speciation_pr <- 1 / speciation_mean
total_speciation ~ dnExponential(speciation_pr)
relative_clado ~ dnDirichlet([1,1,1,1,1]) # Each cladogenetic event type is assigned its own speciation rate.
# Turnover
turnover ~ dnExponential(speciation_pr)

#### MCMC START VALUES (optional)
# Anagenetic rates
gamma.setValue(0.000626)
delta.setValue(0.0126)
rho.setValue(0.00079)
eta.setValue(0.00026)

# Cladogenic rates
relative_clado.setValue(simplex([0.9143,0.0014,0.016,0.0537,0.0128]))
# Speciation rate
total_speciation.setValue(0.412)
# Turnover rate
turnover.setValue(0.344)

#### Set misc. parameters
# Set the probability of sampling species. Emprically determined from PPG1.
frac <- 0.133

#### Run ChromoSSE:
source("scripts/chromosse_tp_mrm.rev")